---
// Hero/inline article image. Styling (incl. SVRNOS.COM watermark) lives in
// src/styles/globals.css under .article-figure, so component-rendered images
// and rehype-wrapped inline markdown images render identically.
interface Props {
  src: string;
  alt: string;
  hero?: boolean;
  loading?: "eager" | "lazy";
}

const { src, alt, hero = false, loading = "lazy" } = Astro.props;
---
<figure class:list={["article-figure", { "article-figure-hero": hero }]}>
  <img src={src} alt={alt} loading={loading} />
</figure>
