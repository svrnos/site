---
// Share button widget — preserves the existing pattern from bespoke insight pages.
// Uses the Web Share API when available (mobile, modern browsers), falls back to
// copying the canonical URL to clipboard. Shares URL + title + description only;
// receiving platforms (LinkedIn, X, iMessage, Slack, etc.) auto-render the
// preview image from the page's og:image meta tag. Attaching the image as a
// file in addition causes platforms that already auto-preview URLs to render
// the same image twice (one as file attachment, one as link card).
//
// Optional `pdfUrl` prop renders a Download PDF button next to Share, used on
// research papers that have a canonical PDF on Zenodo (or elsewhere).

interface Props {
  /** Optional URL to a downloadable PDF. When set, renders a Download button
      next to Share. */
  pdfUrl?: string;
  /** Optional filename hint for the download attribute. Defaults to the URL's
      basename, which works for most Zenodo URLs out of the box. */
  pdfFilename?: string;
  /** Optional aria/visible label for the download button. */
  pdfLabel?: string;
  /** When true, render without the standalone .share-bar wrapper styles
      (max-width, centered margin, padding). Use when the parent context
      provides its own layout, e.g. embedded in a header row. */
  inline?: boolean;
}

const { pdfUrl, pdfFilename, pdfLabel = "Download PDF", inline = false } = Astro.props;
---
<div class:list={["share-bar", inline && "share-bar--inline"]}>
  {pdfUrl && (
    <a
      aria-label={pdfLabel}
      class="paper-action paper-action--primary"
      href={pdfUrl}
      download={pdfFilename}
      rel="noopener"
    >
      <svg
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" x2="12" y1="15" y2="3"></line>
      </svg>
      <span>{pdfLabel}</span>
    </a>
  )}

  <button
    aria-label="Share article"
    class="paper-action paper-action--secondary"
    id="shareBtn"
    type="button"
  >
    <svg
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line>
      <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line>
    </svg>
    <span>Share</span>
  </button>
</div>

<style>
  .share-bar {
    max-width: 68ch;
    margin: 20px auto 0;
    padding: 0 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  /* Inline mode — strip standalone wrapper styles when embedded in a parent
     context (e.g. header row of ArticleLayout). Parent controls layout. */
  .share-bar--inline {
    max-width: none;
    margin: 0;
    padding: 0;
  }

  /* Base — applies to both Download (primary) and Share (secondary). */
  .paper-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 6px;
    font-family: var(--svrnos-font-sans);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.01em;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid var(--svrnos-brand-primary);
    transition: background-color 0.15s ease, color 0.15s ease,
      border-color 0.15s ease;
  }
  .paper-action svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }
  .paper-action:focus-visible {
    outline: 2px solid var(--svrnos-brand-ring, rgba(47, 93, 80, 0.25));
    outline-offset: 2px;
  }

  /* Primary — Download PDF. Solid forest-green, white text. */
  .paper-action--primary {
    background: var(--svrnos-brand-primary);
    color: var(--svrnos-text-on-brand, #ffffff);
  }
  .paper-action--primary:hover {
    background: var(--svrnos-brand-hover);
    border-color: var(--svrnos-brand-hover);
    color: var(--svrnos-text-on-brand, #ffffff);
    text-decoration: none;
  }
  .paper-action--primary:active {
    background: var(--svrnos-brand-active);
    border-color: var(--svrnos-brand-active);
  }

  /* Secondary — Share. Outlined forest-green, transparent background. */
  .paper-action--secondary {
    background: transparent;
    color: var(--svrnos-brand-primary);
  }
  .paper-action--secondary:hover {
    background: var(--svrnos-bg-hover, #f2f5f4);
    color: var(--svrnos-brand-hover);
    border-color: var(--svrnos-brand-hover);
    text-decoration: none;
  }
  .paper-action--secondary:active {
    background: var(--svrnos-bg-selected, #eef3f1);
  }
</style>

<script>
  document.getElementById("shareBtn")?.addEventListener("click", async () => {
    const m = (p: string) =>
      document.querySelector(`meta[property="${p}"]`)?.getAttribute("content") ||
      document.querySelector(`meta[name="${p}"]`)?.getAttribute("content") ||
      "";
    const shareData: ShareData = {
      title: m("og:title") || document.title,
      text: m("og:description") || "",
      url: window.location.href,
    };
    if (navigator.share) {
      try {
        await navigator.share(shareData);
      } catch (e) {
        /* user cancelled */
      }
    } else {
      try {
        await navigator.clipboard.writeText(window.location.href);
        alert("Link copied to clipboard");
      } catch (e) {
        alert("Could not copy link");
      }
    }
  });
</script>
