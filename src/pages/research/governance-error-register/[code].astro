---
// ============================================================================
// Per-code page — /research/governance-error-register/<code>
// ----------------------------------------------------------------------------
// One static page per GER code, generated at build time from src/data/ger.json.
// Each page is a citable permalink (e.g., svrnos.com/research/governance-error-register/501).
// ============================================================================

import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import gerData from "../../../data/ger.json";

interface DocumentedSource {
  source_type: string;
  external_ref: string | null;
  url: string;
  title: string;
}

interface Contributor {
  name: string;
  affiliation: string | null;
  attribution_type: string;
}

interface DistinctFrom {
  contrasted_with: string;
  this_condition: string;
  other_condition: string;
}

interface CodeRecord {
  code: string;
  name: string;
  definition: string;
  tier: string;
  layer: string | null;
  article_url: string | null;
  type: "documented" | "illustrative";
  is_namespace_claim: boolean;
  version_added: string;
  tags: string[];
  distinct_from: DistinctFrom[];
  documented_source: DocumentedSource | null;
  contributors: Contributor[];
}

export async function getStaticPaths() {
  const codes = (gerData as { codes: CodeRecord[] }).codes;
  return codes.map((c) => ({
    params: { code: c.code },
    props: { code: c },
  }));
}

const { code } = Astro.props as { code: CodeRecord };

const TIER_LABEL: Record<string, string> = {
  "0xx": "Pre-Infrastructure",
  "2xx": "Success States",
  "3xx": "Structural Moves",
  "4xx": "Operator / Platform Errors",
  "5xx": "Infrastructure Failures",
};

const citation = `Nzeutem, S. (${new Date().getFullYear()}). GER-${code.code} ${code.name}. SVRNOS Governance Error Register. https://svrnos.com/research/governance-error-register/${code.code}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: `GER-${code.code} ${code.name}`,
  identifier: `GER-${code.code}`,
  description: code.definition,
  inDefinedTermSet: {
    "@type": "DefinedTermSet",
    name: "SVRNOS Governance Error Register",
    url: "https://svrnos.com/research/governance-error-register",
  },
  url: `https://svrnos.com/research/governance-error-register/${code.code}`,
};
---
<ArticleLayout
  title={`GER-${code.code} · ${code.name}`}
  metaTitle={`GER-${code.code} ${code.name} — SVRNOS Governance Error Register`}
  dek={code.definition.length > 220 ? code.definition.slice(0, 220).trim() + "…" : code.definition}
  description={code.definition.length > 220 ? code.definition.slice(0, 220).trim() + "…" : code.definition}
  canonical={`/research/governance-error-register/${code.code}`}
  category={`${code.tier} · ${TIER_LABEL[code.tier]}`}
  current="research"
  jsonLd={jsonLd}
>
  <div class="ger-code-page not-prose max-w-[68ch] mx-auto">

    <!-- Status badges -->
    <div class="flex flex-wrap items-center gap-2 mb-10 text-xs font-mono uppercase tracking-wider">
      <span class={`px-2 py-1 rounded-sm ${code.type === "documented" ? "bg-green-100 text-green-900" : "bg-amber-50 text-amber-900"}`}>
        {code.type === "documented" ? "Documented" : "Illustrative"}
      </span>
      <span class="px-2 py-1 rounded-sm bg-neutral-100 text-neutral-700">
        Tier {code.tier}
      </span>
      {code.layer && (
        <span class="px-2 py-1 rounded-sm bg-neutral-100 text-neutral-700">
          Layer {code.layer}
        </span>
      )}
      {code.is_namespace_claim && (
        <span class="px-2 py-1 rounded-sm bg-blue-50 text-blue-900" title="SVRNOS assigns this code to an HTTP-unassigned slot, following Cloudflare/Twilio/nginx extension precedent.">
          Namespace-Claim
        </span>
      )}
      <span class="px-2 py-1 rounded-sm bg-neutral-50 text-neutral-600">
        Added {code.version_added}
      </span>
    </div>

    <!-- Definition -->
    <section class="mb-12">
      <h2 class="font-mono text-xs uppercase tracking-[0.18em] text-label-alt mb-3">Definition</h2>
      <p class="font-serif text-lg leading-relaxed text-body">
        {code.definition}
      </p>
    </section>

    <!-- Distinct From -->
    {code.distinct_from.length > 0 && (
      <section class="mb-12">
        <h2 class="font-mono text-xs uppercase tracking-[0.18em] text-label-alt mb-3">Distinct From</h2>
        <ul class="space-y-3">
          {code.distinct_from.map((d) => (
            <li class="border-l-2 border-neutral-200 pl-4 py-1">
              <a href={`/research/governance-error-register/${d.contrasted_with}`}
                 class="font-mono text-sm text-heading hover:underline">
                GER-{d.contrasted_with}
              </a>
              <p class="text-sm text-secondary leading-snug mt-1">
                {d.this_condition} → this code. {d.other_condition} → GER-{d.contrasted_with}.
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Documented case (one exemplar per code) -->
    {code.documented_source && (
      <section class="mb-12">
        <h2 class="font-mono text-xs uppercase tracking-[0.18em] text-label-alt mb-3">
          Documented case
        </h2>
        <div class="border border-neutral-200 rounded-sm p-4">
          <div class="flex items-baseline justify-between gap-3 mb-1">
            <a href={code.documented_source.url} target="_blank" rel="noopener"
               class="font-serif text-base text-heading hover:underline">
              {code.documented_source.title}
            </a>
            <span class="font-mono text-[10px] uppercase tracking-wider text-label-alt whitespace-nowrap">
              {code.documented_source.source_type}
            </span>
          </div>
          <p class="font-mono text-xs text-label-alt">
            {code.documented_source.source_type === "aiid"
              ? `AIID #${code.documented_source.external_ref}`
              : code.documented_source.external_ref
                ? `${code.documented_source.source_type} · ${code.documented_source.external_ref}`
                : code.documented_source.source_type} · <a href={code.documented_source.url} target="_blank" rel="noopener" class="hover:underline">source ↗</a>
          </p>
        </div>
      </section>
    )}

    <!-- Case study link if we published an article on it -->
    {code.article_url && (
      <section class="mb-12 bg-neutral-50 rounded-sm p-5">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-label-alt mb-2">Case study</p>
        <a href={code.article_url} class="font-serif text-lg text-heading hover:underline">
          SVRNOS published a case study on this code →
        </a>
      </section>
    )}

    <!-- Tags -->
    {code.tags.length > 0 && (
      <section class="mb-12">
        <h2 class="font-mono text-xs uppercase tracking-[0.18em] text-label-alt mb-3">Tags</h2>
        <div class="flex flex-wrap gap-2">
          {code.tags.map((t) => (
            <span class="px-3 py-1 text-xs bg-neutral-100 text-neutral-700 rounded-full font-mono">
              {t}
            </span>
          ))}
        </div>
      </section>
    )}

    <!-- Contributors -->
    {code.contributors.length > 0 && (
      <section class="mb-12">
        <h2 class="font-mono text-xs uppercase tracking-[0.18em] text-label-alt mb-3">Attributed to</h2>
        <ul class="space-y-2">
          {code.contributors.map((c) => (
            <li class="text-sm text-secondary">
              <span class="text-heading">{c.name}</span>
              {c.affiliation && <span class="text-label-alt"> · {c.affiliation}</span>}
              <span class="ml-2 font-mono text-[10px] uppercase tracking-wider text-label-alt">
                {c.attribution_type}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Cite this code -->
    <section class="mb-8 border-t border-neutral-200 pt-8">
      <h2 class="font-mono text-xs uppercase tracking-[0.18em] text-label-alt mb-3">Cite this code</h2>
      <p class="font-mono text-xs leading-relaxed text-secondary bg-neutral-50 p-4 rounded-sm">
        {citation}
      </p>
    </section>

    <!-- Back to registry -->
    <p class="text-center text-sm">
      <a href="/research/governance-error-register" class="text-label-alt hover:text-heading">
        ← Back to the Governance Error Register
      </a>
    </p>
  </div>
</ArticleLayout>
